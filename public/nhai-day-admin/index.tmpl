    <label>Tên *</label><input type="text" id="f_name" value="${(m.name||"").replace(/"/g,"&quot;")}"/>
    <label>Role</label><input type="text" id="f_role" value="${(m.role||"").replace(/"/g,"&quot;")}" placeholder="Creative"/>
