      <div style="display:flex;gap:8px;align-items:flex-end">
        <div style="flex:1"><label>Emoji icon</label><input type="text" id="np_emoji" value="${ep?e(ep.emoji||'📢'):'📢'}" style="max-width:80px"/></div>
        <div style="flex:1"><label>Ngày đăng</label><input type="date" id="np_date" value="${ep&&ep.published_at?(ep.published_at+'').slice(0,10):new Date().toISOString().slice(0,10)}"/></div>
        <div style="flex:0 0 auto;padding-bottom:8px"><label style="display:flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" id="np_active" ${!ep||ep.is_active?'checked':''}/> Hiển thị trên site</label></div>
      </div>
      <div><label>Season liên quan</label>
        <select id="np_season"><option value="">— Tất cả —</option>${(state.seasons||[]).map(s=>`<option value="${e(s.id)}" ${ep&&ep.season_id===s.id?'selected':''}>${e(s.name)}</option>`).join('')}</select>
      </div>
    </div>
    <div style="padding:0 14px 14px">
      <label>Nội dung / Mô tả ngắn</label>
      <div id="np_toolbar" style="display:flex;flex-wrap:wrap;gap:4px;padding:6px 8px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-bottom:none;border-radius:8px 8px 0 0">
        ${['B','I','U','S'].map(t=>`<button type="button" class="btn" style="padding:2px 8px;font-size:12px;font-weight:${t==='B'?'bold':'400'};font-style:${t==='I'?'italic':'normal'};text-decoration:${t==='S'?'line-through':t==='U'?'underline':'none'}" onclick="document.execCommand('${t==='B'?'bold':t==='I'?'italic':t==='U'?'underline':'strikethrough'}',false)">${t}</button>`).join('')}
        <button type="button" class="btn" style="padding:2px 8px;font-size:12px" onclick="document.execCommand('insertOrderedList',false)">1. List</button>
        <button type="button" class="btn" style="padding:2px 8px;font-size:12px" onclick="document.execCommand('insertUnorderedList',false)">• List</button>
      </div>
      <div id="np_body" contenteditable="true" style="min-height:120px;padding:10px 12px;background:var(--bg2);border:1px solid rgba(255,255,255,.1);border-radius:0 0 8px 8px;outline:none;line-height:1.6;font-size:14px">${ep?ep.body||'':''}</div>
    </div>
  </div>`;

  return `<div class="card" style="margin-bottom:4px">
    <div class="card-header">
      <div><div class="card-title">📰 Tin tức</div><div class="card-sub">Bài mới nhất sẽ hiển thị to trên trang Tin tức. Ảnh bìa/ảnh trong bài tối đa 4MB, tự nén khi lưu. Video = dán link YouTube.</div></div>
      <button class="btn btn-primary" onclick="newPost()">+ Bài mới</button>
    </div>
    <table style="width:100%;border-collapse:collapse">
      <thead><tr style="border-bottom:1px solid rgba(255,255,255,.08)">
        <th style="padding:8px 10px;text-align:left;font-size:12px;color:var(--textM)">TIÊU ĐỀ</th>
        <th style="padding:8px 10px;text-align:left;font-size:12px;color:var(--textM)">NGÀY</th>
        <th style="padding:8px 10px;text-align:center;font-size:12px;color:var(--textM)">HIỂN THỊ</th>
        <th style="padding:8px 10px"></th>
      </tr></thead>
      <tbody>${postRows||'<tr><td colspan="4" style="padding:24px;text-align:center;color:var(--textM)">Chưa có bài nào</td></tr>'}</tbody>
    </table>
  </div>
  ${formHtml}`;
}
async function newPost(){state.editingPost={id:'',title:'',body:'',link_url:'',emoji:'📢',season_id:'',is_active:1,published_at:new Date().toISOString()};render();setTimeout(()=>document.getElementById('np_title')?.focus(),50);}
function cancelEditPost(){state.editingPost=null;render();}
function editPost(id){state.editingPost=state.newsPosts.find(p=>p.id===id)||null;render();setTimeout(()=>document.getElementById('np_title')?.focus(),50);}
async function deletePost(id){
  if(!confirm('Xóa bài này?'))return;
  await sb(`news_posts?id=eq.${id}`,{method:'DELETE'});
  state.newsPosts=state.newsPosts.filter(p=>p.id!==id);
  render();toast('Đã xóa!');
}
async function savePost(){
  const title=document.getElementById('np_title')?.value?.trim();
  if(!title){toast('Cần có tiêu đề','danger');return;}
  const body=document.getElementById('np_body')?.innerHTML||'';
  const link_url=document.getElementById('np_link')?.value?.trim()||'';
  const emoji=document.getElementById('np_emoji')?.value?.trim()||'📢';
  const dateVal=document.getElementById('np_date')?.value;
  const is_active=document.getElementById('np_active')?.checked?1:0;
  const season_id=document.getElementById('np_season')?.value||'';
  const published_at=dateVal?new Date(dateVal).toISOString().slice(0,19).replace('T',' '):(new Date().toISOString().slice(0,19).replace('T',' '));
  const ep=state.editingPost;
  if(ep&&ep.id){
    await sb(`news_posts?id=eq.${ep.id}`,{method:'PATCH',body:{title,body,link_url,emoji,season_id,is_active,published_at}});
    const idx=state.newsPosts.findIndex(p=>p.id===ep.id);
    if(idx>=0)state.newsPosts[idx]={...state.newsPosts[idx],title,body,link_url,emoji,season_id,is_active,published_at};
  }else{
    const id='np-'+Date.now();
    const rows=await sb('news_posts',{method:'POST',body:{id,title,body,link_url,emoji,season_id,is_active,published_at,react_fire:0,react_thumb:0}});
    state.newsPosts.unshift(rows?.[0]||{id,title,body,link_url,emoji,season_id,is_active,published_at,react_fire:0,react_thumb:0});
  }
  state.editingPost=null;
  toast('Đã lưu bài!');render();
}
function renderFeedback(){
  const fbs = state.feedbacks || [];
  const bySeason = {};
  fbs.forEach(f => { if(!bySeason[f.season_id]) bySeason[f.season_id] = []; bySeason[f.season_id].push(f); });
  const seasons = Object.keys(bySeason).sort().reverse();

  const avgRating = (arr, key) => {
    const vals = arr.map(f=>f[key]).filter(v=>v!=null&&v>0);
    return vals.length ? (vals.reduce((a,b)=>a+b,0)/vals.length).toFixed(1) : '—';
  };

  const selectedSeason = window._fbSeasonFilter || (seasons[0] || 'nhai-day-02');
  const shown = bySeason[selectedSeason] || [];

  const mentorAvg = avgRating(shown, 'mentor_rating');
  const overallAvg = avgRating(shown, 'overall_rating');
  const demoCount = shown.filter(f=>f.output_status==='Có, demo được').length;

  return `
  <div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center">
    ${seasons.map(s=>`<button class="btn ${s===selectedSeason?'btn-primary':''}" onclick="window._fbSeasonFilter='${s}';render()">${s}</button>`).join('')}
    <button class="btn" onclick="loadAll()" style="margin-left:auto">🔄 Refresh</button>
  </div>

  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px">
    <div class="card" style="padding:14px;text-align:center"><div style="font-size:22px;font-weight:700">${shown.length}</div><div style="font-size:11px;color:var(--textM)">Responses</div></div>
    <div class="card" style="padding:14px;text-align:center"><div style="font-size:22px;font-weight:700">${overallAvg}★</div><div style="font-size:11px;color:var(--textM)">Overall avg</div></div>
    <div class="card" style="padding:14px;text-align:center"><div style="font-size:22px;font-weight:700">${mentorAvg}★</div><div style="font-size:11px;color:var(--textM)">Hữu Ích avg</div></div>
    <div class="card" style="padding:14px;text-align:center"><div style="font-size:22px;font-weight:700">${demoCount}/${shown.length}</div><div style="font-size:11px;color:var(--textM)">Có demo</div></div>
  </div>

  <div class="card">
    ${shown.length===0?`<div class="empty-state">Chưa có feedback cho mùa này</div>`:
      shown.map(f=>`
      <div style="border-bottom:1px solid var(--border);padding:12px 16px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap">
          <span class="badge ${f.city==='Hà Nội'?'badge-hn':'badge-hcm'}">${f.city}</span>
          <span style="font-size:11px;color:var(--textM)">${f.participation_type}</span>
          <span style="font-size:11px;padding:2px 8px;border-radius:10px;background:${f.output_status==='Có, demo được'?'#22c55e22':'#f9731622'};color:${f.output_status==='Có, demo được'?'#22c55e':'#f97316'}">${f.output_status}</span>
          <span style="margin-left:auto;font-size:11px;color:var(--textM)">${new Date(f.submitted_at).toLocaleDateString('vi-VN')}</span>
        </div>
        ${f.no_output_reason?`<div style="font-size:11px;color:var(--textM);margin-bottom:4px">Lý do: ${e(f.no_output_reason)}</div>`:''}
        <div style="display:flex;gap:16px;margin-bottom:6px">
          ${f.mentor_rating?`<div style="font-size:12px">Mentor: <strong>${f.mentor_rating}/5</strong></div>`:''}
          ${f.overall_rating?`<div style="font-size:12px">Overall: <strong>${f.overall_rating}/5</strong></div>`:''}
          ${f.continue_dev?`<div style="font-size:12px">Tiếp tục: <strong>${f.continue_dev}</strong></div>`:''}
          ${f.recommend?`<div style="font-size:12px">Recommend: <strong>${f.recommend}</strong></div>`:''}
        </div>
        ${f.mentor_comment?`<div style="font-size:12px;color:var(--text);margin-bottom:4px;font-style:italic">"${e(f.mentor_comment)}"</div>`:''}
        ${f.suggestions?`<div style="font-size:12px;color:var(--text);padding:8px 10px;background:var(--surfaceAlt,var(--bg3));border-radius:6px;margin-top:4px">${e(f.suggestions)}</div>`:''}
      </div>`).join('')}
  </div>`;
}

// ===== SUBMISSIONS =====
function renderSubmissions(){
  const subs = (state.submissions||[]);
  const pending = subs.filter(s=>s.status==='pending');
  const approved = subs.filter(s=>s.status==='approved');
  const rejected = subs.filter(s=>s.status==='rejected');
  const filterTab = window._subFilterTab || 'pending';
  const shown = filterTab==='pending'?pending:filterTab==='approved'?approved:rejected;

  return `
  <div style="display:flex;gap:8px;margin-bottom:14px;align-items:center">
    <button class="btn ${filterTab==='pending'?'btn-primary':''}" onclick="window._subFilterTab='pending';render()">${pending.length} Chờ duyệt</button>
    <button class="btn ${filterTab==='approved'?'btn-primary':''}" onclick="window._subFilterTab='approved';render()">${approved.length} Đã duyệt</button>
    <button class="btn ${filterTab==='rejected'?'btn-primary':''}" onclick="window._subFilterTab='rejected';render()">${rejected.length} Đã từ chối</button>
    <button class="btn" onclick="loadAll()" style="margin-left:auto">🔄 Refresh</button>
  </div>
  <div class="card">
    ${shown.length===0?`<div class="empty-state">Không có submission nào</div>`:
      shown.map(s=>`
      <div style="border-bottom:1px solid var(--border);padding:14px 16px">
        <div style="display:flex;align-items:flex-start;gap:10px">
          <div style="flex:1">
            <div style="font-size:13px;font-weight:600;margin-bottom:2px">${e(s.title)}</div>
            <div style="font-size:11px;color:var(--textM);margin-bottom:6px">${e(s.owner_name)} · ${e(s.owner_email)} · <span class="badge ${s.city==='HN'?'badge-hn':'badge-hcm'}">${s.city}</span> · ${new Date(s.submitted_at).toLocaleDateString('vi-VN')}</div>
            <div style="font-size:12px;line-height:1.6;margin-bottom:6px;color:var(--text)">${e(s.description)}</div>
            ${s.tools?`<div style="font-size:11px;color:var(--textM);margin-bottom:4px">🔧 ${e(s.tools)}</div>`:''}
            ${s.team_members?`<div style="font-size:11px;color:var(--textM);margin-bottom:4px">👥 ${e(s.team_members)}</div>`:''}
            <div style="margin-top:6px">
              <a href="${e(s.demo_url)}" target="_blank" style="font-size:12px;color:var(--gold);text-decoration:none;border:1px solid var(--goldBd);padding:3px 10px;border-radius:6px">▶ Xem demo</a>
            </div>
          </div>
          ${s.status==='pending'?`
          <div style="display:flex;flex-direction:column;gap:6px;min-width:120px">
            <button class="btn btn-primary" style="font-size:11px" onclick="openApproveModal('${s.id}')">✓ Approve</button>
            <button class="btn btn-danger" style="font-size:11px" onclick="rejectSub('${s.id}')">✗ Từ chối</button>
          </div>`:`<div style="font-size:11px;color:var(--textM);text-align:right">${s.status==='approved'?'✅ Đã duyệt':'❌ Từ chối'}<br>${s.reviewed_at?new Date(s.reviewed_at).toLocaleDateString('vi-VN'):''}</div>`}
        </div>
      </div>`).join('')}
  </div>

  <!-- Approve modal -->
  <div id="approveModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9999;align-items:center;justify-content:center" onclick="if(event.target===this)closeApproveModal()">
    <div style="background:var(--bg2);border-radius:16px;padding:24px;width:520px;max-width:95vw;max-height:90vh;overflow-y:auto;position:relative">
      <button onclick="closeApproveModal()" style="position:absolute;top:12px;right:12px;background:none;border:none;color:var(--text);font-size:18px;cursor:pointer">✕</button>
      <div style="font-size:16px;font-weight:700;margin-bottom:16px">✓ Approve submission</div>
      <div style="font-size:11px;color:var(--textM);margin-bottom:12px">Chỉnh sửa trước khi approve nếu cần:</div>
      <div style="margin-bottom:10px"><label style="font-size:11px;display:block;margin-bottom:4px;color:var(--textM)">Tên dự án</label><input id="amTitle" style="width:100%;box-sizing:border-box"></div>
      <div style="margin-bottom:10px"><label style="font-size:11px;display:block;margin-bottom:4px;color:var(--textM)">Mô tả</label><textarea id="amDesc" rows="3" style="width:100%;box-sizing:border-box;resize:vertical"></textarea></div>
      <div style="margin-bottom:10px"><label style="font-size:11px;display:block;margin-bottom:4px;color:var(--textM)">Tools (phân cách dấu phẩy)</label><input id="amTools" style="width:100%;box-sizing:border-box"></div>
      <div style="margin-bottom:16px"><label style="font-size:11px;display:block;margin-bottom:4px;color:var(--textM)">Link demo</label><input id="amDemo" style="width:100%;box-sizing:border-box"></div>
      <div style="margin-bottom:16px">
        <label style="font-size:11px;display:block;margin-bottom:4px;color:var(--textM)">Thêm vào campaign voting</label>
        <select id="amCampaign" style="width:100%">
          <option value="">-- Không link vào vote (chỉ tạo case) --</option>
          ${(state.campaigns||[]).map(c=>`<option value="${c.id}">${e(c.name)} (${c.id})</option>`).join('')}
        </select>
      </div>
      <div id="amError" style="color:#ef4444;font-size:12px;margin-bottom:8px;display:none"></div>
      <div style="display:flex;gap:8px">
        <button id="amSubmitBtn" class="btn btn-primary" style="flex:1" onclick="doApprove()">✓ Approve & tạo case</button>
        <button class="btn" onclick="closeApproveModal()">Hủy</button>
      </div>
    </div>
  </div>`;
}

let _approvingSubId = null;
function openApproveModal(subId){
  _approvingSubId = subId;
  const sub = (state.submissions||[]).find(s=>s.id===subId);
  if(!sub) return;
  render();
  setTimeout(()=>{
    const modal=document.getElementById('approveModal');
    if(!modal) return;
    document.getElementById('amTitle').value = sub.title||'';
    document.getElementById('amDesc').value = sub.description||'';
    document.getElementById('amTools').value = sub.tools||'';
    document.getElementById('amDemo').value = sub.demo_url||'';
    document.getElementById('amCampaign').value = '';
    document.getElementById('amError').style.display='none';
    modal.style.display='flex';
  },0);
}
function closeApproveModal(){
  const modal=document.getElementById('approveModal');
  if(modal) modal.style.display='none';
}
async function doApprove(){
  const btn=document.getElementById('amSubmitBtn');
  const errEl=document.getElementById('amError');
  btn.disabled=true; btn.textContent='Đang xử lý...';
  try{
    const res=await fetch('/api/approve-submission',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
      submission_id:_approvingSubId,
      campaign_id:document.getElementById('amCampaign').value||null,
      title:document.getElementById('amTitle').value,
      description:document.getElementById('amDesc').value,
      tools:document.getElementById('amTools').value,
      demo_url:document.getElementById('amDemo').value,
    })});
    const data=await res.json();
    if(!data.ok) throw new Error(data.message);
    closeApproveModal();
    await loadAll();
    toast('Đã approve! Case ID: '+data.case_id);
  }catch(e){
    errEl.textContent=e.message; errEl.style.display='';
    btn.disabled=false; btn.textContent='✓ Approve & tạo case';
  }
}
async function rejectSub(subId){
  const notes=prompt('Lý do từ chối (tùy chọn):');
  if(notes===null) return;
  await fetch('/api/reject-submission',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({submission_id:subId,notes})});
  await loadAll();
  toast('Đã từ chối submission.');
}

// Tab routing: activate correct tab from URL path and handle back/forward
(function(){
  const adminPath=location.pathname.match(/\/nhai-day-admin\/([^\/]+)/);
  if(adminPath&&adminPath[1]) state.tab=adminPath[1];
  window.addEventListener('popstate',function(e){
    if(e.state&&e.state.tab) setTab(e.state.tab,true);
  });
})();

// Init
loadAll();
</script>
</body>
</html>
