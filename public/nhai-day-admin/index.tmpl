  const now=new Date();
  const toLocal=dt=>{if(!dt)return "";const d=new Date(dt);d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,16);};
  const campCard=`
  <div class="card" style="border-top:2px solid var(--gold);margin-bottom:0">
