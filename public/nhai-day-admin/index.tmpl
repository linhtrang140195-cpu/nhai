function calcLiveFeedbackStats(seasonId){
  const fbs=(state.feedbacks||[]).filter(f=>f.season_id===seasonId);
  if(!fbs.length) return null;
  const expArr=fbs.map(f=>f.overall_rating).filter(n=>n&&n>0);
  const menArr=fbs.map(f=>f.mentor_rating).filter(n=>n&&n>0);
  const hasDemo=fbs.filter(f=>/Có, demo|hoàn thiện/i.test(f.output_status||'')).length;
  const wantCont=fbs.filter(f=>/chắc chắn|Có thể/i.test(f.continue_dev||'')).length;
  const willRec=fbs.filter(f=>/^Có$/i.test((f.recommend||'').trim())).length;
  return {
    count:fbs.length,
    avg_experience:expArr.length?+(expArr.reduce((a,b)=>a+b,0)/expArr.length).toFixed(1):null,
    avg_mentor:menArr.length?+(menArr.reduce((a,b)=>a+b,0)/menArr.length).toFixed(1):null,
    pct_has_demo:+(hasDemo/fbs.length*100).toFixed(0),
    pct_want_continue:+(wantCont/fbs.length*100).toFixed(0),
    pct_recommend:+(willRec/fbs.length*100).toFixed(0),
  };
}

function renderAnalytics(){
  const regsA=state.registrations.filter(r=>r.season_id===state.currentSeason);
  const ss=state.seasonStats.find(x=>x.season_id===state.currentSeason)||{};
