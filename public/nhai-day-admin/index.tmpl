  } else if(type==="event"){
    body=`<label>ID</label><input type="text" id="f_id" value="${m.id||""}" placeholder="nd02-hn" ${id?"disabled":""}/>
    <label>Tên sự kiện *</label><input type="text" id="f_name" value="${(m.name||"").replace(/"/g,"&quot;")}" placeholder="NHAI DAY 02 – HN"/>
