async function saveStatOverrides(){
  const n=v=>v===''||v===null||v===undefined?undefined:+v;
  const ov={};
  const xp=n(document.getElementById('ov_avg_xp')?.value);
  const mn=n(document.getElementById('ov_avg_mn')?.value);
  const teams=n(document.getElementById('ov_total_teams')?.value);
  const participants=n(document.getElementById('ov_total_participants')?.value);
  if(xp!==undefined)ov.avg_experience=xp;
  if(mn!==undefined)ov.avg_mentor=mn;
