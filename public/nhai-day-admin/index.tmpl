      <span class="badge ${cs.is_active?"badge-success":"badge-muted"}" style="cursor:pointer" onclick="event.stopPropagation();toggleCaseActive('${cs.id}',${cs.is_active})">${cs.is_active?"Active":"Draft"}</span>
