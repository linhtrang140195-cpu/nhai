  // Merged: prefer live web stats; fall back to ss (Sheet sync)
  const dispExp=lv?.avg_experience||ss.avg_experience||null;
  const dispMentor=lv?.avg_mentor||ss.avg_mentor||null;
  const dispContinue=lv?.pct_want_continue??ss.pct_want_continue??null;
  const dispFbSrc=lv?`${lv.count} web${ss.feedback_count>lv.count?` + ${ss.feedback_count-lv.count} sheet`:''}`:(ss.feedback_count?`${ss.feedback_count} sheet`:null);
  const hcOf=list=>list.length + list.filter(r=>r.member2_name&&r.member2_name.trim()).length + list.filter(r=>r.member3_name&&r.member3_name.trim()).length;
  const headcount=hcOf(regsA);
