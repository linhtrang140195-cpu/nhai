        <button class="btn btn-primary" style="font-size:10px;padding:3px 8px" onclick="editCampaign('${c.id}')">Sửa</button>
        ${!c.is_active?`<button class="btn btn-success" style="font-size:10px;padding:3px 8px" onclick="activateCampaign('${c.id}')">Activate →</button>`:`<button class="btn" style="font-size:10px;padding:3px 8px" onclick="pushCasesToCampaign('${c.id}')">Push cases</button>`}
      </div>`;
    }).join(""):`<div class="empty-state" style="padding:12px">Chưa có campaign</div>`}
    <div style="padding:14px;border-top:1px solid var(--border)">
      <div style="font-size:11px;font-weight:600;color:var(--textM);margin-bottom:8px">+ Tạo campaign mới</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
        <label style="grid-column:1/-1;font-size:11px">Tên campaign<input type="text" id="campName" placeholder="Top Pick Dish 2026 - Day 02" style="margin-bottom:0"/></label>
        <label style="font-size:11px">Mở lúc<input type="datetime-local" id="campOpens" style="margin-bottom:0"/></label>
        <label style="font-size:11px">Đóng lúc<input type="datetime-local" id="campCloses" style="margin-bottom:0"/></label>
        <label style="font-size:11px">Max votes/người/city<input type="number" id="campMaxVotes" value="3" min="1" max="10" style="margin-bottom:0"/></label>
