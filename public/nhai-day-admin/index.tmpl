    <div class="modal-title">Import kết quả — ${parsed.length} winners tìm thấy</div>
    <div style="overflow:auto;max-height:50vh;margin-bottom:12px">
      <table style="width:100%;border-collapse:collapse">
        <tr style="background:var(--bg3);font-size:10px;color:var(--textM)">
          <th style="padding:6px 8px">✓</th><th style="padding:6px 8px;text-align:left">Loại</th>
          <th style="padding:6px 8px;text-align:left">City</th><th style="padding:6px 8px;text-align:left">Team</th><th style="padding:6px 8px;text-align:left">Case</th>
        </tr>${rows}
      </table>
    </div>
    <div style="display:flex;gap:12px;padding:10px;background:var(--bg3);border-radius:8px;margin-bottom:14px;font-size:11px;align-items:center">
      <span style="color:var(--textM)">Trạng thái:</span>
      <label style="display:flex;align-items:center;gap:4px;cursor:pointer;color:var(--teal)"><input type="radio" name="ir_s" value="announced" checked/> Công bố ngay</label>
      <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="radio" name="ir_s" value="pending"/> Lưu nháp</label>
    </div>
    <div class="modal-actions">
      <button class="btn" onclick="closeModal()">Hủy</button>
      <button class="btn btn-primary" onclick='doImportResults(${JSON.stringify(parsed).replace(/'/g,"&#39;")})'>Import ${parsed.length} winners</button>
