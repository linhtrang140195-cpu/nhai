    <label>Trạng thái</label><select id="f_status"><option value="upcoming" ${m.status==="upcoming"?"selected":""}>Upcoming</option><option value="completed" ${m.status==="completed"?"selected":""}>Completed</option><option value="voting_open" ${m.status==="voting_open"?"selected":""}>Voting open</option><option value="voting_closed" ${m.status==="voting_closed"?"selected":""}>Voting closed</option></select>
    <label>Season</label><select id="f_season_id">${state.seasons.map(s=>`<option value="${s.id}" ${(m.season_id||state.currentSeason)===s.id?"selected":""}>${s.name}</option>`).join("")}</select>
    <label>Thứ tự hiển thị (display_order)</label><input type="number" id="f_display_order" value="${m.display_order??state.events.length+1}" placeholder="1, 2, 3..."/>`;
  } else if(type==="faq"){
    body=`<label>Câu hỏi *</label><input type="text" id="f_question" value="${(m.question||"").replace(/"/g,"&quot;")}"/>
    <label>Trả lời *</label><textarea id="f_answer" rows="4">${m.answer||""}</textarea>`;
  }
  const save=type==="mentor"?`saveMentor('${id||""}')`
    :type==="event"?`upsert('events',{${id?"":"id:getField('id'),"} name:getField('name'),date:getField('date')||null,city:getField('city')||null,status:getField('status'),season_id:getField('season_id'),display_order:parseInt(getField('display_order'))||${(m.display_order||state.events.length)+1}},'${id||""}')`
    :`upsert('faqs',{question:getField('question'),answer:getField('answer'),display_order:${(m.display_order||state.faqs.length)+1},is_active:true},'${id||""}')`;
  const titles={mentor:"Mentor",event:"Event",faq:"FAQ"};
  document.getElementById("modalArea").innerHTML=`
  <div class="modal-bg" onclick="closeModal()"><div class="modal" onclick="event.stopPropagation()">
