    <div class="card-header">
      <div><div class="card-title">📝 Drafts chờ duyệt (${filteredDrafts.length})</div><div class="card-sub">Chưa hiện trên website</div></div>
      <button class="btn btn-success" onclick="publishAllDrafts()">Publish tất cả</button>
    </div>
    ${filteredDrafts.map((cs,i)=>renderCaseRow(cs,i)).join("")}
