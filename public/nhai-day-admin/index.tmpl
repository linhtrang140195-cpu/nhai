      <button class="btn" onclick="closeModal()">Hủy</button>
      <button class="btn btn-primary" onclick="saveCampaignEdit('${id}')">Lưu</button>
    </div>
  </div></div>`;
}

async function saveCampaignEdit(id){
  const name=document.getElementById('ec_name')?.value.trim();
  const opensAt=document.getElementById('ec_opens')?.value;
  const closesAt=document.getElementById('ec_closes')?.value;
  const maxVotes=parseInt(document.getElementById('ec_max')?.value)||3;
  if(!name){toast("Cần có tên","danger");return;}
  await sb(`top_pick_campaigns?id=eq.${id}`,{method:"PATCH",body:{name,opens_at:opensAt?opensAt.replace('T',' '):null,closes_at:closesAt?closesAt.replace('T',' '):null,max_votes_per_device:maxVotes}});
  toast("Đã lưu campaign");closeModal();loadAll();
}

async function activateCampaign(id){
  for(const c of state.campaigns){
    if(c.id!==id&&c.is_active)await sb(`top_pick_campaigns?id=eq.${c.id}`,{method:"PATCH",body:{is_active:0}});
  }
  await sb(`top_pick_campaigns?id=eq.${id}`,{method:"PATCH",body:{is_active:1}});
  await pushCasesToCampaign(id);
}

async function pushCasesToCampaign(id){
  const activeCases=state.cases.filter(c=>c.is_active&&c.season_id===state.currentSeason);
  if(!activeCases.length){toast("Không có active case nào trong season này để push","danger");return;}
  let added=0;
  for(const c of activeCases){
    const city=c.city==="Hồ Chí Minh"?"HCM":"HN";
    await sb("top_pick_cases",{method:"POST",body:{case_id:c.id,campaign_id:id,city,title:c.title,is_active:1},headers:{Prefer:"return=minimal"}}).catch(()=>{});
    added++;
  }
  toast(`Đã push ${added} cases vào campaign`);loadAll();
}

