function _getRoadmapItems(){
  let cfg=state.config.roadmap_config;
  if(typeof cfg==='string') try{cfg=JSON.parse(cfg);}catch{cfg=null;}
  return (Array.isArray(cfg)&&cfg.length)?cfg:_ROADMAP_DEFAULT;
}

function _snapshotRoadmap(){
  const items=_getRoadmapItems();
  return items.map((r,i)=>({
    ...r,
    status:document.getElementById(`rm_status_${i}`)?.value||r.status,
    date:document.getElementById(`rm_date_${i}`)?.value||r.date,
    name:document.getElementById(`rm_name_${i}`)?.value||r.name,
    articleUrl:(document.getElementById(`rm_url_${i}`)?.value||'').trim()||r.articleUrl||'',
  }));
}
function moveRoadmapItem(i,dir){
  const items=_snapshotRoadmap();
  const j=i+dir;
  if(j<0||j>=items.length) return;
  [items[i],items[j]]=[items[j],items[i]];
  state.config.roadmap_config=items;
  render();
}
function addRoadmapItem(){
  const items=_snapshotRoadmap();
  items.push({status:'tbd',name:'Sự kiện mới',date:''});
  state.config.roadmap_config=items;
  render();
}
function removeRoadmapItem(i){
  const items=_snapshotRoadmap();
  items.splice(i,1);
  state.config.roadmap_config=items;
  render();
}
