  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
    <div class="city-tabs">
      <div class="city-tab ${f==="all"?"active-all":""}" onclick="setCityFilter('all')">Tất cả (${actives.length})</div>
      <div class="city-tab ${f==="hn"?"active-hn":""}" onclick="setCityFilter('hn')">🔴 HN (${actives.filter(c=>c.city==="Hà Nội").length})</div>
      <div class="city-tab ${f==="hcm"?"active-hcm":""}" onclick="setCityFilter('hcm')">🟢 HCM (${actives.filter(c=>c.city==="Hồ Chí Minh").length})</div>
    </div>
    <button class="btn" onclick="openCaseModal()">+ Thêm tay</button>
  </div>

  <div class="card">
    <div class="card-header"><div class="card-title">❤️ Cases đang vote · ${filteredActives.length} cases</div></div>
    ${filteredActives.length?filteredActives.map((cs,i)=>renderCaseRow(cs,i)).join(""):'<div class="empty-state">Chưa có case active · Import từ Sheet hoặc thêm tay</div>'}
  </div>`;
}

async function publishAllDrafts(){
  const drafts=state.cases.filter(c=>!c.is_active&&c.season_id===state.currentSeason);
  for(const d of drafts)await sb(`cases?id=eq.${d.id}`,{method:"PATCH",body:{is_active:true}});
  toast(`Đã publish ${drafts.length} cases`);loadAll();
}

async function importSubmissionsFromSheet(){
  const url=getUrl("submissions");
  if(!url){toast("Chưa có gid","danger");return;}
  toast("Đang fetch sheet submissions...");
  try{
    const res=await fetch(url);
    if(!res.ok)throw new Error("Fetch failed — đã publish sheet chưa?");
    const rows=parseCSV(await res.text());
    if(rows.length<2){toast("Sheet trống","danger");return;}
    const headers=rows[0];
    const findCol=(kws)=>headers.findIndex(h=>kws.some(k=>h.toLowerCase().includes(k.toLowerCase())));
    const emailCol=findCol(["email"]);
    const titleCol=findCol(["tên case","case","title"]);
    const cityCol=findCol(["đâu","city","thành phố","nhai day tại"]);
    const descCol=findCol(["mô tả","description","ngắn gọn"]);
    const demoCol=findCol(["demo","file","link","sản phẩm"]);
    const existingEmails=new Set(state.cases.filter(c=>c.season_id===state.currentSeason).map(c=>c.owner_email).filter(Boolean));
    const parsed=[];
    for(const row of rows.slice(1)){
      const email=(emailCol>=0?row[emailCol]:"")||"";
      if(!email||!email.includes("@")||existingEmails.has(email))continue;
      const title=(titleCol>=0?row[titleCol]:"")||"";
      const cityRaw=(cityCol>=0?row[cityCol]:"")||"";
      const desc=(descCol>=0?row[descCol]:"")||"";
      const demo=(demoCol>=0?row[demoCol]:"")||"";
      if(!title.trim())continue;
      const city=cityRaw.includes("Hồ Chí Minh")||cityRaw.includes("HCM")?"Hồ Chí Minh":"Hà Nội";
      parsed.push({email,title:title.slice(0,120),city,desc,demo});
    }
    if(!parsed.length){toast(`Không có case mới (${rows.length-1} rows đã import hết)`);return;}
    // Auto import all as draft
    let n=0;
    for(const p of parsed){
      const id=(p.city==="Hà Nội"?"hn":"hcm")+"-auto-"+Date.now()+"-"+(n++);
      await sb("cases",{method:"POST",body:{id,title:p.title,city:p.city,sticker:"🤖",owner_email:p.email,owner_name:p.email.split("@")[0],short_description:p.desc,demo_url:p.demo,tools_used:[],season_id:state.currentSeason,display_order:state.cases.length+n,is_active:false},headers:{Prefer:"return=representation"}});
    }
    toast(`Đã import ${n} cases mới (draft)`);loadAll();
  }catch(e){toast("Lỗi: "+e.message,"danger");}
}

let _csvRows=null;
function importSubmissionsFromCSVFile(input){
  const file=input.files[0];if(!file)return;input.value='';
  const reader=new FileReader();
  reader.onload=function(e){
    try{
      const rows=parseCSV(e.target.result);
      if(rows.length<2){toast("File trống","danger");return;}
      _csvRows=rows;
      showCsvMappingUI(rows);
    }catch(err){toast("Lỗi đọc file: "+err.message,"danger");}
  };
  reader.readAsText(file,'UTF-8');
}

function showCsvMappingUI(rows){
  const ncols=rows[0].length;
  // Auto-suggest: find col with most "@" → email, most city → city
  const atCount=Array(ncols).fill(0),cityCount=Array(ncols).fill(0);
  for(const row of rows){for(let ci=0;ci<ncols;ci++){const v=row[ci]||"";if(v.includes("@"))atCount[ci]++;if(v.includes("Hà Nội")||v.includes("Hồ Chí"))cityCount[ci]++;}}
  const suggestEmail=atCount.indexOf(Math.max(...atCount));
  const suggestCity=cityCount.indexOf(Math.max(...cityCount));
  const usedCols=new Set([suggestEmail,suggestCity]);
  const textCols=[...Array(ncols).keys()].filter(ci=>!usedCols.has(ci)&&ci!==0);
  const suggestTitle=textCols[0]??2,suggestDesc=textCols[1]??4,suggestDemo=textCols[2]??5;
  // Preview: first 2 data rows (skip if first row is header)
  const firstIsHeader=!rows[0][suggestEmail]?.includes("@");
  const preview=rows.slice(firstIsHeader?1:0,firstIsHeader?3:2);
  const opts=Array.from({length:ncols},(_,i)=>`<option value="${i}">Cột ${i}: ${(rows[0][i]||"").slice(0,30)}</option>`).join("");
  const selOf=(name,def)=>`<select id="csvMap_${name}" style="width:100%;padding:6px 8px;border-radius:6px;border:1px solid var(--line);background:var(--night);color:var(--cream);font-size:13px">${Array.from({length:ncols},(_,i)=>`<option value="${i}"${i===def?" selected":""}>${i}: ${(rows[0][i]||"").slice(0,35)}</option>`).join("")}<option value="-1">— Bỏ qua —</option></select>`;
  const previewHtml=preview.map(r=>`<tr>${r.map(c=>`<td style="padding:3px 6px;border:1px solid var(--line);font-size:11px;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(c||"").slice(0,40)}</td>`).join("")}</tr>`).join("");
  const el=document.getElementById("csvMappingZone");
  if(el){el.innerHTML=`
    <div style="background:var(--cardBg);border:1px solid var(--goldBd);border-radius:12px;padding:16px;margin-top:12px">
      <div style="font-weight:700;color:var(--gold);margin-bottom:10px">📋 Chọn cột tương ứng (${rows.length} rows, ${ncols} cột)</div>
      <div style="overflow-x:auto;margin-bottom:12px"><table style="border-collapse:collapse">${previewHtml}</table></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px">
        <label style="font-size:12px;color:var(--textS)">Email *${selOf("email",suggestEmail)}</label>
        <label style="font-size:12px;color:var(--textS)">Tên case *${selOf("title",suggestTitle)}</label>
        <label style="font-size:12px;color:var(--textS)">City (HN/HCM)${selOf("city",suggestCity)}</label>
        <label style="font-size:12px;color:var(--textS)">Mô tả${selOf("desc",suggestDesc)}</label>
        <label style="font-size:12px;color:var(--textS)">Demo URL${selOf("demo",suggestDemo)}</label>
        <label style="font-size:12px;color:var(--textS)">Row đầu là header?<select id="csvMap_hasHeader" style="width:100%;padding:6px 8px;border-radius:6px;border:1px solid var(--line);background:var(--night);color:var(--cream);font-size:13px"><option value="${firstIsHeader?1:0}" selected>${firstIsHeader?"Có (bỏ qua row 1)":"Không (import từ row 1)"}</option><option value="${firstIsHeader?0:1}">${firstIsHeader?"Không (import từ row 1)":"Có (bỏ qua row 1)"}</option></select></label>
      </div>
      <button class="btn btn-primary" onclick="doImportFromCsvMapping()">Import →</button>
      <button class="btn" onclick="_csvRows=null;document.getElementById('csvMappingZone').innerHTML=''" style="margin-left:8px">Hủy</button>
    </div>`;}
}

async function doImportFromCsvMapping(){
  if(!_csvRows){toast("Chưa có file","danger");return;}
  const get=id=>{const el=document.getElementById(id);return el?parseInt(el.value):-1;};
  const emailCol=get("csvMap_email"),titleCol=get("csvMap_title"),cityCol=get("csvMap_city"),descCol=get("csvMap_desc"),demoCol=get("csvMap_demo");
  const hasHeader=get("csvMap_hasHeader")===1;
  if(emailCol<0||titleCol<0){toast("Phải chọn cột Email và Tên case","danger");return;}
  const dataRows=hasHeader?_csvRows.slice(1):_csvRows;
  const existingEmails=new Set(state.cases.filter(c=>c.season_id===state.currentSeason).map(c=>c.owner_email).filter(Boolean));
  const parsed=[];
  for(const row of dataRows){
    const email=(row[emailCol]||"").trim();
    if(!email||!email.includes("@")||existingEmails.has(email))continue;
    const title=(row[titleCol]||"").trim();if(!title)continue;
    const cityRaw=cityCol>=0?row[cityCol]||"":"";
    const desc=descCol>=0?row[descCol]||"":"";
    const demo=demoCol>=0?row[demoCol]||"":"";
    const city=cityRaw.includes("Hồ Chí Minh")||cityRaw.includes("HCM")?"Hồ Chí Minh":"Hà Nội";
    parsed.push({email,title:title.slice(0,120),city,desc,demo});
  }
  if(!parsed.length){toast(`Không có case mới — đã có ${existingEmails.size} email trong season này`,"danger");return;}
  let n=0;
  for(const p of parsed){
    const id=(p.city==="Hà Nội"?"hn":"hcm")+"-auto-"+Date.now()+"-"+(n++);
    await sb("cases",{method:"POST",body:{id,title:p.title,city:p.city,sticker:"🤖",owner_email:p.email,owner_name:p.email.split("@")[0],short_description:p.desc,full_description:p.desc,demo_url:p.demo,tools_used:[],season_id:state.currentSeason,display_order:state.cases.length+n,is_active:false},headers:{Prefer:"return=representation"}});
  }
  toast(`Đã import ${n} cases (draft)`);_csvRows=null;document.getElementById("csvMappingZone").innerHTML="";loadAll();
}

async function createCampaignForSeason(){
  const name=document.getElementById('campName')?.value.trim();
  const opensAt=document.getElementById('campOpens')?.value;
  const closesAt=document.getElementById('campCloses')?.value;
  const maxVotes=parseInt(document.getElementById('campMaxVotes')?.value)||3;
  if(!name||!opensAt||!closesAt){toast("Điền đủ Tên, Giờ mở, Giờ đóng","danger");return;}
  const id='top-pick-'+state.currentSeason+'-'+Date.now();
  await sb("top_pick_campaigns",{method:"POST",body:{id,name,opens_at:opensAt.replace('T',' '),closes_at:closesAt.replace('T',' '),max_votes_per_device:maxVotes,is_active:0},headers:{Prefer:"return=minimal"}});
  toast("Đã tạo campaign, đang activate...");
  await activateCampaign(id);
}

function editCampaign(id){
  const c=state.campaigns.find(x=>x.id===id);if(!c)return;
  const toLocal=dt=>{if(!dt)return "";const d=new Date(dt);d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,16);};
  document.getElementById('modalArea').innerHTML=`
  <div class="modal-bg" onclick="closeModal()"><div class="modal" onclick="event.stopPropagation()">
    <div class="modal-title">Sửa campaign: ${c.name}</div>
    <label>Tên</label><input type="text" id="ec_name" value="${(c.name||"").replace(/"/g,'&quot;')}"/>
    <div class="two-col">
      <div><label>Mở lúc</label><input type="datetime-local" id="ec_opens" value="${toLocal(c.opens_at)}"/></div>
      <div><label>Đóng lúc</label><input type="datetime-local" id="ec_closes" value="${toLocal(c.closes_at)}"/></div>
    </div>
    <label>Max votes/người/city</label><input type="number" id="ec_max" value="${c.max_votes_per_device||3}" min="1" max="10"/>
