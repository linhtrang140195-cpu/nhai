  const allHeadcount=hcOf(state.registrations);
  const seasonCount=new Set(state.registrations.map(r=>r.season_id).filter(Boolean)).size||1;
  const teamCounts={};
  // Đếm cả TV2, TV3
  regsA.forEach(r=>{
    const t=r.team||"Khác";teamCounts[t]=(teamCounts[t]||0)+1;
    if(r.member2_name&&r.member2_name.trim()){const t2=r.member2_team||t;teamCounts[t2]=(teamCounts[t2]||0)+1;}
    if(r.member3_name&&r.member3_name.trim()){const t3=r.member3_team||t;teamCounts[t3]=(teamCounts[t3]||0)+1;}
  });
  const sorted=Object.entries(teamCounts).sort((a,b)=>b[1]-a[1]);
  const total=headcount||1;
  const colors=["var(--gold)","var(--pink)","var(--teal)","var(--purple)","#D97757","#14B8A6","#A78BFA","#EC4899","#EF9F27","#5EEAD4"];
  const bars=sorted.map(([t,c],i)=>{const p=Math.round(c/total*100);return `<div style="margin-bottom:12px"><div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px"><span style="font-weight:500">${t}</span><span style="color:var(--textM)">${c} người · <span style="color:${colors[i%colors.length]};font-weight:600;font-family:monospace">${p}%</span></span></div><div style="background:rgba(255,255,255,0.04);border-radius:99px;height:8px;overflow:hidden"><div style="height:100%;border-radius:99px;background:${colors[i%colors.length]};width:${p}%"></div></div></div>`;}).join("");
